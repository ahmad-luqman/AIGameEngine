[
	{ "id": "open", "command": "scene.open", "params": { "path": "Assets/Scenes/FeatureTest.bscene" } },
	{ "id": "key", "command": "input.key", "params": { "key": "Space", "down": true } },
	{ "id": "mouse", "command": "input.mouse", "params": { "position": [320, 240], "button": "Left", "down": true } },
	{ "id": "play", "command": "play.start" },
	{ "id": "press-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "key-up", "command": "input.key", "params": { "key": "Space", "down": false } },
	{ "id": "mouse-up", "command": "input.mouse", "params": { "position": [330, 250], "button": "Left", "down": false } },
	{ "id": "run", "command": "play.step", "params": { "frames": 169, "assertNoErrors": true } },
	{ "id": "report", "command": "lua.exec", "params": { "code": "FeatureTest.Report()" } },
	{ "id": "stop", "command": "play.stop" },
	{ "id": "image-same", "command": "image.compare", "params": { "actual": "Assets/Textures/Checker.png", "reference": "Assets/Textures/Checker.png", "assertMatch": true } },
	{ "id": "hash", "command": "scene.hash" },
	{ "id": "record", "command": "replay.record_start" },
	{ "id": "replay-play", "command": "play.start" },
	{ "id": "replay-key", "command": "input.key", "params": { "key": "Space", "down": true } },
	{ "id": "replay-step", "command": "play.step", "params": { "frames": 3, "hash": true, "assertNoErrors": true } },
	{ "id": "replay-key-up", "command": "input.key", "params": { "key": "Space", "down": false } },
	{ "id": "replay-save", "command": "replay.record_stop", "params": { "path": "Saved/FeatureTest.breplay" } },
	{ "id": "replay-run", "command": "replay.run", "params": { "path": "Saved/FeatureTest.breplay", "assertHash": true, "assertNoErrors": true } },
	{ "id": "replay-stop", "command": "play.stop" },
	{ "id": "image-differs", "command": "image.compare", "params": { "actual": "Assets/Textures/Checker.png", "reference": "Assets/Textures/FlatNormal.png" } },
	{ "id": "hash-new-scene", "command": "scene.new", "params": { "name": "HashCheck", "empty": true } },
	{ "id": "hash-ground", "command": "entity.create", "params": { "name": "Ground", "components": { "Transform": { "Translation": [0, -0.5, 0] }, "RigidBody": {}, "BoxCollider": { "HalfExtents": [5, 0.5, 5] } } } },
	{ "id": "hash-box", "command": "entity.create", "params": { "name": "Box", "components": { "Transform": { "Translation": [0.25, 3, 0] }, "RigidBody": { "Type": "Dynamic" }, "BoxCollider": {} } } },
	{ "id": "hash-play", "command": "play.start" },
	{ "id": "hash-step", "command": "play.step", "params": { "frames": 60, "expectHash": "0c7663d08635b679" } },
	{ "id": "hash-mismatch", "command": "scene.hash", "params": { "expectHash": "0000000000000000" }, "expectError": "differs from the expected 0000000000000000" },
	{ "id": "hash-empty", "command": "play.step", "params": { "expectHash": "" }, "expectError": "must be a non-empty string" },
	{ "id": "hash-misspelled", "command": "scene.hash", "params": { "expect": "0000000000000000" }, "expectError": "unknown parameter 'expect'" },
	{ "id": "hash-stop", "command": "play.stop" }
]
