# TEMPORARY (PR #53): runs the unit tests under cdb (normal heap, then full page heap) so the Windows Release heap error
# prints every thread's stack where it is detected. Always fails, so ctest shows the output.
set(key "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\BasaltTraceCopy.exe")
get_filename_component(dir "${TESTS}" DIRECTORY)
file(COPY_FILE "${TESTS}" "${dir}/BasaltTraceCopy.exe")
file(GLOB cdb "C:/Program Files (x86)/Windows Kits/10/Debuggers/x64/cdb.exe")
message("cdb: ${cdb}")
set(commands ".echo STACK; .lastevent; kn 100; .echo THREADS; ~*kn 60; .echo AVRF; !avrf; .echo END; q")
function(trace label)
	execute_process(COMMAND "${cdb}" -g -G -lines -y "${dir}" -c "${commands}" "${dir}/BasaltTraceCopy.exe" ${ARGN} --reporters=console --no-intro=true
		TIMEOUT 1200 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
	string(FIND "${output}" "STACK" found)
	if(found GREATER -1)
		string(SUBSTRING "${output}" ${found} -1 tail)
		message("==== ${label}: result ${result}\n${tail}")
	else()
		string(LENGTH "${output}" length)
		math(EXPR start "${length} - 3000")
		if(start LESS 0)
			set(start 0)
		endif()
		string(SUBSTRING "${output}" ${start} -1 tail)
		message("==== ${label}: result ${result} (no break)\n${tail}")
	endif()
endfunction()
execute_process(COMMAND reg delete "${key}" /f)
foreach(i RANGE 1 3)
	trace("normal heap, archive tests, run ${i}" -ts=Archive)
endforeach()
trace("normal heap, all tests")
execute_process(COMMAND reg add "${key}" /v GlobalFlag /t REG_SZ /d 0x02000000 /f)
execute_process(COMMAND reg add "${key}" /v PageHeapFlags /t REG_SZ /d 0x3 /f)
trace("page heap, archive tests" -ts=Archive)
execute_process(COMMAND reg delete "${key}" /f)
message(FATAL_ERROR "trace finished (fails on purpose to show the output)")
