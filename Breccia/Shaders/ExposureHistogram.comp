#version 450
// Meters finite nonblack HDR luminance into a logarithmic histogram.
#include "Exposure.glsl"
layout(local_size_x = HistogramGroupSize, local_size_y = HistogramGroupSize) in;
layout(set = 0, binding = 0) uniform texture2D u_HDR;
layout(set = 0, binding = 1) uniform sampler u_PointClamp;
layout(std430, set = 0, binding = 2) buffer Histogram
{
	uint Bins[HistogramBins];
}
u_Histogram;

shared uint bins[HistogramBins];
void main()
{
	uint index = gl_LocalInvocationIndex;
	bins[index] = 0u;
	barrier();
	uvec2 p = gl_GlobalInvocationID.xy;
	if (all(lessThan(p, u_Push.Size)))
	{
		vec3 c = texelFetch(sampler2D(u_HDR, u_PointClamp), ivec2(p), 0).rgb;
		// Reject invalid RGB before max(), whose NaN selection can differ between drivers.
		float luminance = any(isnan(c)) || any(isinf(c)) ? 0.0 : dot(max(c, vec3(0)), vec3(0.2126, 0.7152, 0.0722));
		// Bin zero holds black/invalid pixels and is excluded from metering. Remaining bins span -12..16 EV.
		uint bin = 0u;
		if (luminance > 1e-6 && !isnan(luminance) && !isinf(luminance))
			bin = 1u + uint(clamp((log2(luminance) - HistogramMinEV) / HistogramEVSpan, 0.0, 1.0) * HistogramIntervals);
		atomicAdd(bins[bin], 1u);
	}
	barrier();
	atomicAdd(u_Histogram.Bins[index], bins[index]);
}
