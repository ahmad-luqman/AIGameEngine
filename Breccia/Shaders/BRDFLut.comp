#version 450
#include "CubeMap.glsl"

// Split-sum environment BRDF lookup table: x = NdotV, y = roughness -> (scale, bias) for F0.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 2, rg16f) uniform writeonly image2D u_LUT;

float GeometrySchlickGGXIBL(float NdotX, float roughness)
{
	float k = (roughness * roughness) / 2.0;
	return NdotX / (NdotX * (1.0 - k) + k);
}

void main()
{
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(u_LUT);
	if (id.x >= size.x || id.y >= size.y)
		return;

	float NdotV = max((float(id.x) + 0.5) / float(size.x), 1e-3);
	float roughness = (float(id.y) + 0.5) / float(size.y);
	vec3 V = vec3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
	vec3 N = vec3(0.0, 0.0, 1.0);

	float A = 0.0;
	float B = 0.0;
	const uint sampleCount = 1024u;
	for (uint i = 0u; i < sampleCount; i++)
	{
		vec3 H = ImportanceSampleGGX(Hammersley(i, sampleCount), N, roughness);
		vec3 L = normalize(2.0 * dot(V, H) * H - V);
		float NdotL = max(L.z, 0.0);
		float NdotH = max(H.z, 0.0);
		float VdotH = max(dot(V, H), 0.0);
		if (NdotL > 0.0)
		{
			float G = GeometrySchlickGGXIBL(NdotV, roughness) * GeometrySchlickGGXIBL(NdotL, roughness);
			float visibility = (G * VdotH) / max(NdotH * NdotV, 1e-5);
			float Fc = pow(1.0 - VdotH, 5.0);
			A += (1.0 - Fc) * visibility;
			B += Fc * visibility;
		}
	}
	imageStore(u_LUT, id, vec4(A / float(sampleCount), B / float(sampleCount), 0.0, 1.0));
}
