#version 450
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 2) readonly buffer Histogram
{
	uint Bins[256];
}
u_Histogram;
layout(r32f, set = 0, binding = 3) uniform image2D u_Exposure;
layout(push_constant) uniform ExposurePush
{
	uvec2 Size;
	float MinExposure;
	float MaxExposure;
	float Compensation;
	float Blend;
	uint Reset;
}
u_Push;
void main()
{
	float sum = 0.0, count = 0.0;
	for (uint i = 1u; i < 256u; ++i)
	{
		float n = float(u_Histogram.Bins[i]);
		sum += (-12.0 + (float(i) - 0.5) * 28.0 / 254.0) * n;
		count += n;
	}
	float target = count > 0.0 ? 0.18 / exp2(sum / count) * exp2(u_Push.Compensation) : 1.0;
	target = clamp(target, u_Push.MinExposure, u_Push.MaxExposure);
	float previous = u_Push.Reset != 0u ? target : imageLoad(u_Exposure, ivec2(0)).r;
	imageStore(u_Exposure, ivec2(0), vec4(clamp(mix(previous, target, u_Push.Blend), u_Push.MinExposure, u_Push.MaxExposure)));
}
