	{"id": "replay-committed", "command": "replay.run", "params": {"path": "Replays/Gameplay.breplay", "assertNoErrors": true}},
	{"id": "board-committed", "command": "lua.exec", "params": {"code": "local Expected = '........../........../........../........../........../........../........../........../....T..I../..TTTT.I../.TTTSS.I../...SS..I../....J..ZZ./..L.JJJ.ZZ/OOL...IIII/OOLLL...T./.SS.L..TTT/SS..LL.Z../J..OO.ZZ../JJJOO.Z... score=368 lines=0' local t = Scene.FindEntityByName('Tetris'):GetScript() local rows = {} for y = t.Height - 1, 0, -1 do local row = '' for x = 0, t.Width - 1 do local c = t:Cell(x, y) row = row .. (c and c or '.') end rows[#rows + 1] = row end local board = table.concat(rows, '/') .. ' score=' .. t.Score .. ' lines=' .. t.Lines assert(board == Expected, 'board differs: ' .. board) return board"}},
