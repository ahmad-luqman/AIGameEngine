[
	{"id": "open", "command": "scene.open", "params": {"path": "Assets/Scenes/FirstPerson.bscene"}},
	{"id": "events", "command": "events.subscribe", "params": {"types": ["collision", "scriptError", "playState"]}},
	{"id": "log", "command": "events.subscribe", "params": {"types": ["log"]}},
	{"id": "snapshot-edit", "command": "scene.snapshot", "params": {"name": "edit"}},
	{"id": "saved-scene-matches", "command": "scene.diff", "params": {"from": "Assets/Scenes/FirstPerson.bscene", "to": "edit", "assertEqual": true}},
	{"id": "player-character", "command": "assert.component", "params": {"entity": "Player", "component": "CharacterController", "exists": true}},
	{"id": "listener-on-camera", "command": "assert.component", "params": {"entity": "Camera", "component": "AudioListener", "fields": {"Active": true}}},
	{"id": "drone-doppler", "command": "assert.component", "params": {"entity": "Drone", "component": "AudioSource", "fields": {"Doppler": 1, "Loop": true, "Spatial": true}}},
	{"id": "hall-trigger", "command": "assert.component", "params": {"entity": "HallZone", "component": "RigidBody", "fields": {"IsTrigger": true}}},
	{"id": "center-mouse", "command": "input.mouse", "params": {"position": [960, 540]}},
	{"id": "play", "command": "play.start"},
	{"id": "first-frames", "command": "play.step", "params": {"frames": 10, "assertNoErrors": true}},
	{"id": "helpers", "command": "lua.exec", "params": {"code": "function Game() return Scene.FindEntityByName('Game'):GetScript() end\nfunction Player() return Scene.FindEntityByName('Player'):GetScript() end\nfunction Forward() return Scene.FindEntityByName('Camera'):GetForward() end\nfunction Near(a, b, tolerance) return math.abs(a - b) <= (tolerance or 1e-3) end\nfunction Generator() return Scene.FindEntityByName('Generator'):GetComponent('AudioSource') end\nfunction Standing(name) return Scene.FindEntityByName(name):FindChild('Face').WorldPosition.y > 0.8 end\nSpeedOfSound = 343.3\nDopplerSamples = {}\n-- Records the drone's speed toward the listener (from its actual movement, as the audio system measures it) and the\n-- Doppler pitch its sound got.\nfunction SampleDoppler()\n\tlocal drone = Scene.FindEntityByName('Drone')\n\tlocal toListener = (Scene.FindEntityByName('Camera').WorldPosition - drone.WorldPosition):Normalized()\n\tlocal sample = { Closing = toListener:Dot(drone:GetScript().Velocity), Pitch = drone:GetAudioDopplerPitch() }\n\tDopplerSamples[#DopplerSamples + 1] = sample\n\treturn string.format('%.2f %.4f', sample.Closing, sample.Pitch)\nend"}},
	{"id": "setup", "command": "lua.exec", "params": {"code": "local g, p = Game(), Player()\nassert(Input.GetCursorMode() == 'Locked', 'cursor ' .. Input.GetCursorMode())\nlocal names = {}\nfor _, action in ipairs(Input.GetActions()) do names[#names + 1] = action.Name end\nassert(table.concat(names, ',') == 'MoveX,MoveY,LookX,LookY,Jump,Fire,Unlock', table.concat(names, ','))\nassert(g.Score == 0 and g.TargetCount == 3, 'score ' .. g.Score .. ' targets ' .. g.TargetCount)\nassert(g.Area == 'Courtyard' and Near(Audio.GetReverb().RoomSize, 0.3), 'area ' .. tostring(g.Area))\nassert(Near(Scene.FindEntityByName('Gun'):GetComponent('AudioSource').ReverbSend, 0.08), 'gun send')\nassert(g.Occluded == true and Generator().LowPass == 500, 'the wall hides the generator at the start')\nassert(Scene.FindEntityByName('Generator'):IsAudioPlaying() and Scene.FindEntityByName('Drone'):IsAudioPlaying(), 'loops play')\nassert(Scene.FindEntityByName('Player'):IsGrounded(), 'player grounded')\nlocal f = Forward()\nassert(Near(f.x, 0) and Near(f.y, 0) and Near(f.z, -1), 'looks down -Z')\nreturn 'ok'"}},
	{"id": "hud-score", "command": "assert.component", "params": {"entity": "ScoreText", "component": "UIText", "fields": {"Text": "TARGETS 0"}}},
	{"id": "hud-area", "command": "assert.component", "params": {"entity": "AreaText", "component": "UIText", "fields": {"Text": "COURTYARD"}}},
	{"id": "hud-hint", "command": "assert.component", "params": {"entity": "HintText", "component": "UIText", "fields": {"Text": "WASD move   Space jump   Click shoot   Esc release the mouse"}}},
