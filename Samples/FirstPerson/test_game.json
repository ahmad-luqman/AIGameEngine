	{"id": "in-the-hall", "command": "lua.exec", "params": {"code": "local g, p = Game(), Scene.FindEntityByName('Player')\nassert(p.Translation.x < -8 and math.abs(p.Translation.z) < 1.5, 'position ' .. tostring(p.Translation))\nlocal reverb = Audio.GetReverb()\nassert(g.Area == 'Hall' and Near(reverb.RoomSize, 0.92) and Near(reverb.Damping, 0.15), 'area ' .. tostring(g.Area))\nassert(Near(Scene.FindEntityByName('Gun'):GetComponent('AudioSource').ReverbSend, 0.55) and Near(p:GetComponent('AudioSource').ReverbSend, 0.55), 'sends')\nassert(g.Occluded == true, 'the hall walls hide the generator')\nreturn 'ok'"}},
