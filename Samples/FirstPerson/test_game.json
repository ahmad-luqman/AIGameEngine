	{"id": "doppler-checked", "command": "lua.exec", "params": {"code": "local higher, lower = 0, 0\nfor i, s in ipairs(DopplerSamples) do\n\t-- The listener stands still, so the shift is the physical ratio for the drone's speed toward it.\n\tlocal expected = SpeedOfSound / (SpeedOfSound - s.Closing)\n\tassert(math.abs(s.Pitch - expected) < 0.002, 'sample ' .. i .. ' closing at ' .. s.Closing .. ' has pitch ' .. s.Pitch .. ', expected ' .. expected)\n\tif s.Closing > 3 then higher = higher + 1 end\n\tif s.Closing < -3 then lower = lower + 1 end\nend\nassert(higher > 0 and lower > 0, higher .. ' closing and ' .. lower .. ' leaving samples')\nreturn higher .. ' closing, ' .. lower .. ' leaving'"}},
