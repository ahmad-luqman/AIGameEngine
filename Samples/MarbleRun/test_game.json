[
	{ "id": "open", "command": "scene.open", "params": { "path": "Assets/Scenes/MarbleRun.bscene" } },
	{ "id": "events", "command": "events.subscribe", "params": { "types": ["collision", "scriptError", "playState"] } },
	{ "id": "log", "command": "events.subscribe", "params": { "types": ["log"] } },
	{ "id": "snapshot-edit", "command": "scene.snapshot", "params": { "name": "edit" } },
	{ "id": "saved-scene-matches", "command": "scene.diff", "params": { "from": "Assets/Scenes/MarbleRun.bscene", "to": "edit", "assertEqual": true } },

	{ "id": "one-goal", "command": "assert.entity_exists", "params": { "entity": "Goal", "count": 1 } },
	{ "id": "no-marble-yet", "command": "assert.entity_exists", "params": { "entity": "Marble", "exists": false } },
	{ "id": "goal-is-trigger", "command": "assert.component", "params": { "entity": "Goal", "component": "RigidBody", "fields": { "IsTrigger": true } } },
	{ "id": "spinner-motor", "command": "assert.component", "params": { "entity": "Spinner", "component": "Joint", "fields": { "Type": "Hinge", "MotorMode": "Velocity", "MotorTarget": 120 } } },
	{ "id": "spinner-welded", "command": "assert.component", "params": { "entity": "SpinnerCross", "component": "Joint", "fields": { "Type": "Fixed", "ConnectedEntity": "Spinner" } } },
	{ "id": "seesaw-limits", "command": "assert.component", "params": { "entity": "Seesaw", "component": "Joint", "fields": { "Type": "Hinge", "UseLimits": true, "LimitMin": -10, "LimitMax": 10 } } },
	{ "id": "gate-slider", "command": "assert.component", "params": { "entity": "Gate", "component": "Joint", "fields": { "Type": "Slider", "MotorMode": "Position", "MotorTarget": 0 } } },
	{ "id": "hum-is-spatial", "command": "assert.component", "params": { "entity": "SpinnerHub", "component": "AudioSource", "fields": { "Clip": "Assets/Audio/Hum.wav", "Spatial": true, "Loop": true, "PlayOnStart": true } } },
	{ "id": "drop-button", "command": "assert.component", "params": { "entity": "DropButton", "component": "UIButton", "fields": { "Target": "Director", "OnClick": "OnDrop" } } },

	{ "id": "play", "command": "play.start" },
	{ "id": "drop-press", "command": "input.mouse", "params": { "position": [1520, 216], "button": "Left", "down": true } },
	{ "id": "drop-press-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "drop-release", "command": "input.mouse", "params": { "button": "Left", "down": false } },
	{ "id": "drop-click-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "one-marble", "command": "assert.entity_exists", "params": { "entity": "Marble", "count": 1 } },
	{ "id": "marble-never-sleeps", "command": "assert.component", "params": { "entity": "Marble", "component": "RigidBody", "fields": { "Type": "Dynamic", "AllowSleeping": false } } },
	{ "id": "hud-start", "command": "assert.component", "params": { "entity": "Scoreboard", "component": "UIText", "fields": { "Text": "Scored 0 / 5   Lost 0" } } },

	{ "id": "speed-press", "command": "input.mouse", "params": { "position": [1636, 312], "button": "Left", "down": true } },
	{ "id": "speed-press-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "speed-release", "command": "input.mouse", "params": { "button": "Left", "down": false } },
	{ "id": "speed-release-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "speed-applied", "command": "assert.component", "params": { "entity": "Spinner", "component": "Joint", "fields": { "MotorTarget": 195 }, "tolerance": 1 } },

	{ "id": "run-10s", "command": "play.step", "params": { "frames": 596, "assertNoErrors": true } },
	{ "id": "spinner-turned", "command": "scene.diff", "params": { "from": "edit", "tolerance": 0.5, "assertEqual": true }, "expectError": "'Spinner' Transform.Rotation" },

	{ "id": "hold-press", "command": "input.mouse", "params": { "position": [1560, 364], "button": "Left", "down": true } },
	{ "id": "hold-press-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "hold-release", "command": "input.mouse", "params": { "button": "Left", "down": false } },
	{ "id": "hold-release-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "hold-checked", "command": "assert.component", "params": { "entity": "HoldGate", "component": "UICheckbox", "fields": { "Checked": true } } },
	{ "id": "run-to-open-phase", "command": "play.step", "params": { "frames": 328, "assertNoErrors": true } },
	{ "id": "gate-held-shut", "command": "assert.component", "params": { "entity": "Gate", "component": "Joint", "fields": { "MotorTarget": 0 } } },
	{ "id": "gate-down", "command": "assert.component", "params": { "entity": "Gate", "component": "Transform", "fields": { "Translation": [2.5, 4.5629, 0] }, "tolerance": 0.05 } },
	{ "id": "held-in-open-phase", "command": "lua.exec", "params": { "code": "local d = Scene.FindEntityByName('Director'):GetScript(); assert(d.GateOpen, 'the gate cycle is not in its open phase: the step counts no longer match GateOpenTime/GateClosedTime'); assert(d.HoldGate, 'the checkbox did not reach the Director'); return 'held while the cycle is open'" } },
	{ "id": "marbles-queue", "command": "play.step", "params": { "frames": 660, "assertNoErrors": true } },
	{ "id": "queued-marbles-awake", "command": "lua.exec", "params": { "code": "local resting = 0; for _, marble in ipairs(Scene.FindEntitiesByName('Marble')) do assert(not marble:IsSleeping(), 'a marble fell asleep at ' .. tostring(marble.Translation)); if marble.Translation.x > 1 and marble.Translation.x < 2.5 and marble:GetLinearVelocity():Length() < 0.5 then resting = resting + 1 end end; assert(resting >= 2, 'fewer than 2 marbles wait at the gate: ' .. resting); return resting .. ' marbles wait at the gate'" } },
	{ "id": "unhold-press", "command": "input.mouse", "params": { "position": [1560, 364], "button": "Left", "down": true } },
	{ "id": "unhold-press-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "unhold-release", "command": "input.mouse", "params": { "button": "Left", "down": false } },
	{ "id": "unhold-release-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "run-to-next-open-phase", "command": "play.step", "params": { "frames": 88, "assertNoErrors": true } },
	{ "id": "gate-opens-again", "command": "assert.component", "params": { "entity": "Gate", "component": "Joint", "fields": { "MotorTarget": 1 } } },
	{ "id": "gate-up", "command": "assert.component", "params": { "entity": "Gate", "component": "Transform", "fields": { "Translation": [2.5, 5.5629, 0] }, "tolerance": 0.15 } },

	{ "id": "course-events", "command": "events.poll", "params": { "subscription": 1, "expect": [
		{ "event": "playState", "state": "play" },
		{ "event": "collision", "type": "collisionBegin", "a": { "name": "Seesaw" }, "b": { "name": "Marble" } },
		{ "event": "collision", "type": "triggerEnter", "a": { "name": "Checkpoint" }, "b": { "name": "Marble" } },
		{ "event": "collision", "type": "triggerEnter", "a": { "name": "Checkpoint" }, "b": { "name": "Marble" } },
		{ "event": "collision", "type": "collisionBegin", "a": { "name": "Ramp3Deck" }, "b": { "name": "Marble" } },
		{ "event": "collision", "type": "collisionBegin", "a": { "name": "Gate" }, "b": { "name": "Marble" } }
	] } },
	{ "id": "seesaw-tipped", "command": "lua.exec", "params": { "code": "local lowest = Scene.FindEntityByName('Director'):GetScript().SeesawLowest; assert(lowest < -5, 'the seesaw never tipped: ' .. lowest); return lowest" } },
	{ "id": "drain-log", "command": "events.poll", "params": { "subscription": 2 } },

	{ "id": "run-to-the-end", "command": "play.step", "params": { "frames": 1920, "assertNoErrors": true } },
	{ "id": "goal-events", "command": "events.poll", "params": { "subscription": 1, "expect": [
		{ "event": "collision", "type": "triggerEnter", "a": { "name": "Goal" }, "b": { "name": "Marble" } }
	] } },
	{ "id": "scored-log", "command": "events.poll", "params": { "subscription": 2, "expect": [{ "event": "log", "logger": "APP", "text": "MarbleRun: scored 5" }] } },
	{ "id": "hud-done", "command": "assert.component", "params": { "entity": "Scoreboard", "component": "UIText", "fields": { "Text": "Scored 5 / 5   Lost 0   Done!" } } },
	{ "id": "progress-full", "command": "assert.component", "params": { "entity": "Progress", "component": "UISlider", "fields": { "Value": 1 } } },
	{ "id": "marbles-consumed", "command": "assert.entity_exists", "params": { "entity": "Marble", "exists": false } },
	{ "id": "sensors", "command": "lua.exec", "params": { "code": "local function sensor(name) return Scene.FindEntityByName(name):GetScript() end; local goal, check, kill = sensor('Goal'), sensor('Checkpoint'), sensor('KillFloor'); assert(goal.Entered == 5, 'goal entered ' .. goal.Entered); assert(goal.Emitted == 5 * goal.Burst, 'confetti emitted ' .. goal.Emitted); assert(check.Entered >= 5 and check.Emitted == check.Entered * check.Burst, 'checkpoint ' .. check.Entered .. '/' .. check.Emitted); assert(kill.Entered == 0, 'lost ' .. kill.Entered); assert(Scene.FindEntityByName('SpinnerHub'):IsAudioPlaying(), 'the spinner hum stopped'); return 'checkpoint passes ' .. check.Entered" } },

	{ "id": "arm-double-enter", "command": "lua.exec", "params": { "code": "local d = Scene.FindEntityByName('Director'):GetScript(); local update = d.OnUpdate; d.OnUpdate = function(self, dt) update(self, dt); if self.Probe then return end; self.Probe = { Scored = self.Scored, Lost = self.Lost }; local marble = Scene.Instantiate('Assets/Prefabs/Marble.bprefab', Vec3(0, 30, 0)); local goal = Scene.FindEntityByName('Goal'):GetScript(); goal:OnTriggerEnter(marble, {}); goal:OnTriggerEnter(marble, {}); Scene.FindEntityByName('KillFloor'):GetScript():OnTriggerEnter(marble, {}); self.Probe.Scored = self.Scored - self.Probe.Scored; self.Probe.Lost = self.Lost - self.Probe.Lost end; return 'armed'" } },
	{ "id": "double-enter-frame", "command": "play.step", "params": { "frames": 1, "assertNoErrors": true } },
	{ "id": "removed-marble-counts-once", "command": "lua.exec", "params": { "code": "local p = Scene.FindEntityByName('Director'):GetScript().Probe; assert(p, 'the probe did not run'); assert(p.Scored == 1 and p.Lost == 0, string.format('a removed marble was counted again: scored +%d, lost +%d', p.Scored, p.Lost)); return 'counted once'" } },
	{ "id": "stop", "command": "play.stop" },
	{ "id": "stopped", "command": "events.poll", "params": { "subscription": 1, "expect": [{ "event": "playState", "state": "stop" }] } },
	{ "id": "edit-scene-untouched", "command": "scene.diff", "params": { "from": "edit", "assertEqual": true } }
]
